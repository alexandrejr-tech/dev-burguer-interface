# Copie este arquivo para .env e preencha com seus valores.
# Nunca faça commit do .env.
# Atenção: o Vite grava estes valores no bundle durante o build.
# Use aqui apenas valores públicos e refaça o build após alterá-los.

# URL pública da API (sem barra no final)
VITE_API_URL=http://localhost:3001

# Chave PUBLICÁVEL do Stripe (pk_test_... para testes)
VITE_STRIPE_PUBLIC_KEY=pk_test_sua_chave_aqui
